  "home": {
    "state_mandated": false,
    "notes": "Homeowners insurance is NOT required by state law in any US state. However, mortgage lenders universally require it. Coverage should be based on the home's replacement cost (not market value). Flood and earthquake damage are NOT covered by standard HO policies and require separate coverage.",
    "recommended_minimums": {
      "dwelling_coverage": "100% of home replacement cost (not market value)",
      "other_structures": "10% of dwelling coverage",
      "personal_property": "50-70% of dwelling coverage",
      "loss_of_use": "20-30% of dwelling coverage",
      "personal_liability": 300000,
      "medical_payments": 5000
    },
    "critical_gaps_to_check": [
      "Flood insurance (separate NFIP or private policy required — never included in HO)",
      "Earthquake insurance (required in CA, WA, OR, AK, NV seismic zones)",
      "Replacement cost vs Actual Cash Value (ACV pays depreciated value — get RCV)",
      "Sewer/water backup rider (typically excluded from standard HO)",
      "Scheduled personal property for valuables over $2,500",
      "Home business coverage if operating any business from home",
      "Umbrella policy for liability over $300,000"
    ],
    "high_risk_states": {
      "FL": "Hurricane, flood, sinkholes — extra windstorm coverage often required",
      "LA": "Hurricane and flood — NFIP or private flood essential",
      "TX": "Hail, wind, hurricane on coast — check windstorm exclusions",
      "CA": "Wildfire and earthquake — many insurers restricting coverage",
      "OK": "Tornado and hail — check wind/hail deductibles",
      "CO": "Hail damage is the #1 claim — check hail deductibles",
      "NC": "Hurricane on coast — check windstorm/flood riders",
      "SC": "Hurricane and flood — NFIP coverage important"
    }
  }
}
